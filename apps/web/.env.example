# Copy to `.env` and fill in what you need. Everything here is optional: the
# site builds and serves with none of it set, and each variable switches on one
# thing. `pnpm sushindustries setup` says which ones are missing and why.
#
# On Railway these are service variables rather than a file:
#
#   railway variables --service web --set NAME=value
#
# Nothing in this file is a real value. It is committed; `.env` is not.

# ─── analytics ──────────────────────────────────────────────────────────
#
# Browser-visible PostHog configuration. Requests use the same-origin /ingest
# relay, so no third-party host is contacted directly. The key is public by
# design - it can only write events.
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=/ingest

# Server-side destination for the /ingest relay.
POSTHOG_HOST=https://your-posthog-host

# ─── the database ───────────────────────────────────────────────────────
#
# Postgres. Railway sets this on the service; it is only needed here for local
# work against a database. Unset, the site still renders every page - the
# counters are simply absent, and the migration runner exits 0 rather than
# failing a deploy.
DATABASE_URL=postgresql://user:password@host:5432/database

# ─── the machine-readable surfaces ──────────────────────────────────────
#
# One token, three endpoints: /mcp, /graphql and /studio. Unset, all three
# answer 503 rather than serving anonymously - a private endpoint that quietly
# becomes public when a variable fails to load is the failure worth designing
# against.
#
# Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=

# ─── signing in with GitHub ─────────────────────────────────────────────
#
# What turns /studio from "paste a bearer token" into a sign-in page. Both or
# neither: a client id with no secret produces a redirect that lands on a
# callback which cannot complete, which is a worse failure than not offering
# the button at all.
#
# Create the app at https://github.com/settings/developers -> New OAuth App:
#
#   Application name          <owner> studio
#   Homepage URL              https://adamjurek.com
#   Application description   (leave it empty)
#   Authorization callback    https://adamjurek.com/auth/github/callback
#
# The callback must match exactly - scheme, host, path, no trailing slash.
# GitHub rejects a mismatch with an error that does not say which character
# was wrong.
#
# For localhost you need a second app, because GitHub allows one callback URL
# per app. Its callback is http://localhost:3000/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Falls back to MCP_AUTH_TOKEN when unset, which is
# already a high-entropy secret this deployment holds - so this exists for
# separating the two concerns rather than because sign-in needs it.
SESSION_SECRET=

# ─── OAuth for /mcp ─────────────────────────────────────────────────────
#
# The authorization server that issues tokens for this resource. Naming one
# switches on the discovery document at
# /.well-known/oauth-protected-resource and the RFC 9728 challenge, which is
# what lets an MCP client sign a person in with a browser instead of being
# handed a token.
#
# There is no authorization server yet. Until there is, leave this unset:
# both surfaces then say so plainly, and pointing a client at discovery that
# dead-ends fails later and less clearly than a plain 401 does.
AUTH_ISSUER=

# ─── the assistant ──────────────────────────────────────────────────────
#
# Groq, for the assistant on the desktop. Unset, the assistant is absent
# rather than broken.
GROQ_API_KEY=
