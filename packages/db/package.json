{
	"name": "@sushindustries/db",
	"version": "0.1.0",
	"type": "module",
	"description": "The schema and the client. Drizzle over Postgres, with the connection kept server-side by construction.",
	"keywords": [
		"drizzle",
		"postgres",
		"schema"
	],
	"files": [
		"dist",
		"src",
		"drizzle.config.ts"
	],
	"scripts": {
		"build": "tsdown",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"drizzle-orm": "0.45.2",
		"postgres": "3.4.9"
	},
	"devDependencies": {
		"drizzle-kit": "0.31.10"
	},
	"exports": {
		"./client.server": {
			"import": "./dist/client.server.mjs",
			"require": "./dist/client.server.cjs"
		},
		"./schema": {
			"import": "./dist/schema.mjs",
			"require": "./dist/schema.cjs"
		},
		"./package.json": "./package.json",
		"./client": {
			"import": "./dist/client.server.mjs",
			"require": "./dist/client.server.cjs"
		}
	},
	"engines": {
		"node": ">=20.17.0"
	}
}
