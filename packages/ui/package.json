{
	"name": "@sushindustries/ui",
	"version": "0.1.0",
	"type": "module",
	"description": "The components this site is made of. Every one of them is installable on its own - nothing here is site-specific.",
	"keywords": [
		"react",
		"components",
		"scroll",
		"markdown"
	],
	"files": [
		"src",
		"registry.ts",
		"docs"
	],
	"peerDependencies": {
		"@sushindustries/atoms": "workspace:*",
		"@tanstack/highlight": "^0.0.10",
		"@tanstack/markdown": "^0.0.13",
		"lenis": "^1.3.26",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/highlight": {
			"optional": true
		},
		"@tanstack/markdown": {
			"optional": true
		},
		"lenis": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@tanstack/highlight": "^0.0.10",
		"@tanstack/markdown": "^0.0.13",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.4",
		"lenis": "^1.3.26",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "4.4.3"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./archive": {
			"import": "./dist/archive.mjs",
			"require": "./dist/archive.cjs"
		},
		"./card": {
			"import": "./dist/card.mjs",
			"require": "./dist/card.cjs"
		},
		"./doc-aside": {
			"import": "./dist/doc-aside.mjs",
			"require": "./dist/doc-aside.cjs"
		},
		"./icon": {
			"import": "./dist/icon.mjs",
			"require": "./dist/icon.cjs"
		},
		"./markdown-view": {
			"import": "./dist/markdown-view.mjs",
			"require": "./dist/markdown-view.cjs"
		},
		"./reveal": {
			"import": "./dist/reveal.mjs",
			"require": "./dist/reveal.cjs"
		},
		"./scroll-spin": {
			"import": "./dist/scroll-spin.mjs",
			"require": "./dist/scroll-spin.cjs"
		},
		"./section": {
			"import": "./dist/section.mjs",
			"require": "./dist/section.cjs"
		},
		"./showcase": {
			"import": "./dist/showcase.mjs",
			"require": "./dist/showcase.cjs"
		},
		"./smooth-scroll": {
			"types": "./dist/smooth-scroll.d.cts",
			"import": "./dist/smooth-scroll.mjs",
			"require": "./dist/smooth-scroll.cjs"
		},
		"./registry": {
			"types": "./registry.ts",
			"import": "./registry.ts",
			"require": "./registry.ts",
			"default": "./registry.ts",
			"module": "./registry.ts",
			"browser": "./registry.ts",
			"production": "./registry.ts"
		},
		"./package.json": "./package.json"
	}
}
