{
	"name": "@sushindustries/ui",
	"version": "0.1.0",
	"type": "module",
	"description": "The components this site is made of. Every one of them is installable on its own \u2014 nothing here is site-specific.",
	"keywords": [
		"react",
		"components",
		"scroll",
		"markdown"
	],
	"exports": {
		".": "./src/index.ts",
		"./reveal": "./src/reveal.tsx",
		"./smooth-scroll": "./src/smooth-scroll.tsx",
		"./scroll-spin": "./src/scroll-spin.tsx",
		"./card": "./src/card.tsx",
		"./section": "./src/section.tsx",
		"./markdown-view": "./src/markdown-view.tsx",
		"./registry": "./registry.ts",
		"./showcase": "./src/showcase.tsx",
		"./icon": "./src/icon.tsx",
		"./doc-aside": "./src/doc-aside.tsx",
		"./archive": "./src/archive.tsx"
	},
	"files": [
		"src",
		"registry.ts",
		"docs"
	],
	"peerDependencies": {
		"@sushindustries/atoms": "workspace:*",
		"@tanstack/highlight": "^0.0.10",
		"@tanstack/markdown": "^0.0.13",
		"lenis": "^1.3.26",
		"react": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/highlight": {
			"optional": true
		},
		"@tanstack/markdown": {
			"optional": true
		},
		"lenis": {
			"optional": true
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@tanstack/highlight": "^0.0.10",
		"@tanstack/markdown": "^0.0.13",
		"@types/react": "19.2.18",
		"lenis": "^1.3.26",
		"react": "^19.2.8",
		"zod": "4.4.3"
	}
}
