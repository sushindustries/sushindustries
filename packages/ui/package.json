{
	"name": "@sushindustries/ui",
	"version": "0.1.0",
	"type": "module",
	"description": "The components this site is made of. Every one of them is installable on its own - nothing here is site-specific.",
	"keywords": [
		"react",
		"components",
		"scroll",
		"markdown"
	],
	"files": [
		"dist",
		"src",
		"registry.ts",
		"docs"
	],
	"peerDependencies": {
		"@sushindustries/atoms": "workspace:*",
		"@tanstack/highlight": "^0.0.10",
		"@tanstack/markdown": "^0.0.13",
		"lenis": "^1.3.26",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/highlight": {
			"optional": true
		},
		"@tanstack/markdown": {
			"optional": true
		},
		"lenis": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@tanstack/highlight": "^0.0.10",
		"@tanstack/markdown": "^0.0.13",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.4",
		"lenis": "^1.3.26",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "4.4.3"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./archive": {
			"import": "./dist/archive.js",
			"require": "./dist/archive.cjs"
		},
		"./card": {
			"import": "./dist/card.js",
			"require": "./dist/card.cjs"
		},
		"./doc-aside": {
			"import": "./dist/doc-aside.js",
			"require": "./dist/doc-aside.cjs"
		},
		"./icon": {
			"import": "./dist/icon.js",
			"require": "./dist/icon.cjs"
		},
		"./markdown-view": {
			"import": "./dist/markdown-view.js",
			"require": "./dist/markdown-view.cjs"
		},
		"./registry": {
			"import": "./dist/registry.js",
			"require": "./dist/registry.cjs"
		},
		"./reveal": {
			"import": "./dist/reveal.js",
			"require": "./dist/reveal.cjs"
		},
		"./scroll-spin": {
			"import": "./dist/scroll-spin.js",
			"require": "./dist/scroll-spin.cjs"
		},
		"./section": {
			"import": "./dist/section.js",
			"require": "./dist/section.cjs"
		},
		"./showcase": {
			"import": "./dist/showcase.js",
			"require": "./dist/showcase.cjs"
		},
		"./smooth-scroll": {
			"import": "./dist/smooth-scroll.js",
			"require": "./dist/smooth-scroll.cjs"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20.17.0"
	},
	"types": "./dist/index.d.cts"
}
