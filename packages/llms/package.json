{
	"name": "@sushindustries/llms",
	"version": "0.1.0",
	"type": "module",
	"description": "Generate llms.txt, llms-full.txt, robots.txt and sitemap.xml from one description of a site. Framework-agnostic strings in, strings out.",
	"license": "MIT",
	"keywords": [
		"llms.txt",
		"robots.txt",
		"sitemap",
		"seo",
		"ai"
	],
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20.17.0"
	},
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sushindustries/sushindustries.git",
		"directory": "packages/llms"
	},
	"homepage": "https://adamjurek.com/packages/llms"
}
