{
	"name": "@sushindustries/react-product-viewer",
	"version": "0.1.0",
	"description": "A React Three Fiber viewer for a single GLB product: orbit, contact shadow, runtime material variants, geometric zone tinting, and a PNG snapshot.",
	"author": "Adam Jurek",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20.17.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sushindustries/product-viewer.git",
		"directory": "packages/react-product-viewer"
	},
	"homepage": "https://github.com/sushindustries/product-viewer",
	"keywords": [
		"react",
		"react-three-fiber",
		"3d",
		"gltf",
		"glb",
		"three",
		"configurator",
		"material-variants",
		"tanstack",
		"tanstack-intent"
	],
	"types": "./dist/index.d.mts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./query": {
			"import": {
				"types": "./dist/query.d.mts",
				"default": "./dist/query.mjs"
			},
			"require": {
				"types": "./dist/query.d.cts",
				"default": "./dist/query.cjs"
			}
		},
		"./router": {
			"import": {
				"types": "./dist/router.d.mts",
				"default": "./dist/router.mjs"
			},
			"require": {
				"types": "./dist/router.d.cts",
				"default": "./dist/router.cjs"
			}
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist",
		"src",
		"skills"
	],
	"scripts": {
		"build": "tsdown",
		"test:types": "tsc --noEmit",
		"test:build": "publint --strict && attw --pack . --profile node16"
	},
	"dependencies": {
		"@sushindustries/product-viewer": "workspace:*"
	},
	"peerDependencies": {
		"@react-three/drei": ">=10",
		"@react-three/fiber": ">=9",
		"@tanstack/react-query": ">=5",
		"@tanstack/react-router": ">=1.100.0",
		"react": ">=19",
		"three": ">=0.160.0",
		"three-stdlib": ">=2.30.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		},
		"@tanstack/react-router": {
			"optional": true
		}
	},
	"devDependencies": {
		"@react-three/drei": "10.7.8",
		"@react-three/fiber": "9.7.0",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.29",
		"@testing-library/react": "^16.3.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/three": "0.185.4",
		"jsdom": "^28.0.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"three": "0.185.1",
		"three-custom-shader-material": "6.4.0",
		"three-stdlib": "2.36.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
