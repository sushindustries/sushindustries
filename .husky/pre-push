#!/bin/sh
#
# The gate that runs before anything leaves this machine.
#
# Every check here exists because something got past it once. The build is the
# expensive one and it is not optional: import protection and workspace
# resolution only fail at build time, so a push without it is a guess.
#
# Order is cheapest first, so the common failure costs seconds. The doctor only
# reads the directory; biome only reads the files; the build is last.
#
# Skip deliberately with `git push --no-verify` when you know what you are
# doing - a hook you cannot bypass is a hook people delete.

set -e

echo "-> doctor"
node scripts/doctor.mjs

echo "-> format and lint"
pnpm exec biome check .

# `typecheck` depends on `build` in turbo.json, because the route tree is
# generated and gitignored. Without that order this passes here on a stale
# generated file and fails in a clean checkout, which is exactly how the last
# red CI run happened.
echo "-> types"
pnpm run typecheck

echo "-> build"
pnpm run build

# The pages themselves, against the server the build just produced: every
# sitemap URL's document semantics over HTTP, and its geometry in headless
# Chromium at phone and desktop widths. A machine without the browser skips
# the geometry half with a warning; CI runs it always.
echo "-> pages"
pnpm run test

echo "ok to push"
