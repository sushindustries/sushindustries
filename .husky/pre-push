#!/bin/sh
#
# The gate that runs before anything leaves this machine.
#
# One line on purpose: the list lives in a root script, so the hook and a human
# typing the same command run the same thing and neither can drift. The doctor
# asserts this file stays a delegation and does not grow its own list again.
#
# `check:fast` rather than `check`, and the difference is where the slow half
# went rather than whether it runs. The doctor's drift subset, the formatter and
# the types take seconds; the build, the browser tests and the screenshot
# freshness take minutes, and CI runs every one of them on the push this hook
# just allowed. Paying for both meant paying twice for the same answer, and the
# one that arrived first was the one blocking the person who had already
# finished the work.
#
# Skip deliberately with `git push --no-verify` - a hook you cannot bypass is a
# hook people delete.

pnpm run check:fast
