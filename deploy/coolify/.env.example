# ===== Image =====
# Optional. GHCR tag used by hosts that pull instead of build. Default: main.
IMAGE_TAG=

# ===== App =====
# Optional. Server port inside the container. Default: 3000 (keep in sync with the Coolify domain port).
PORT=
# Optional. Analytics host for the /ingest relay; empty means the relay is not mounted. Also a build arg.
POSTHOG_HOST=
# Optional. Public PostHog project key (write-only by design). Build arg; empty builds a site that measures nothing.
VITE_POSTHOG_KEY=
# Optional. PostHog host the browser reports to. Build arg.
VITE_POSTHOG_HOST=
# Optional (UNKNOWN whether required). Groq API key for /api/chat. Set in Coolify as a secret.
GROQ_API_KEY=

# ===== Database =====
# Optional. Database name. Default: sushindustries.
POSTGRES_DB=
# DATABASE_URL, POSTGRES_USER and POSTGRES_PASSWORD are built from Coolify magic vars
# (SERVICE_USER_POSTGRES, SERVICE_PASSWORD_64_POSTGRES); do not set them by hand.
