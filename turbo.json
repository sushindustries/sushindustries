{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["tsconfig.base.json", "tsdown.base.ts"],
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!tests/**"
			]
		},
		"build": {
			"dependsOn": ["^build", "transit"],
			"outputs": [".output/**", "dist/**", "src/routeTree.gen.ts"],
			"env": [
				"NODE_ENV",
				"POSTHOG_HOST",
				"VITE_POSTHOG_HOST",
				"VITE_POSTHOG_KEY"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!tests/**"
			]
		},
		"typecheck": {
			"dependsOn": ["^build", "build"]
		},
		"test": {
			"dependsOn": ["build"],
			"env": ["CI"],
			"passThroughEnv": ["DATABASE_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
