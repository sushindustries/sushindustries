{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["tsconfig.base.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**", "src/routeTree.gen.ts"],
			"env": ["NODE_ENV"]
		},
		"typecheck": {
			"dependsOn": ["^build", "build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
