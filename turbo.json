{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": [
		"tsconfig.base.json",
		"tsdown.base.ts",
		"packages/atoms/src/**"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".output/**", "dist/**", "src/routeTree.gen.ts"],
			"env": ["NODE_ENV"]
		},
		"typecheck": {
			"dependsOn": ["^build", "build"]
		},
		"test": {
			"dependsOn": ["build"],
			"env": ["CI"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
