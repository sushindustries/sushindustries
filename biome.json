{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"useConst": "error"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.output",
			"!**/dist",
			"!**/routeTree.gen.ts",
			"!packages/product-viewer",
			"!packages/react-product-viewer",
			"!**/.turbo",
			"!**/.nitro",
			"!**/.tanstack",
			"!apps/web/public/logos"
		]
	}
}
