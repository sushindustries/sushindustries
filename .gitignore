node_modules
.output
.nitro
.tanstack
.turbo
dist
.env
.env.local
*.log
.DS_Store
__pycache__/

# Generated by the TanStack Router plugin on every build.
**/routeTree.gen.ts

# Playwright MCP scratch output
.playwright-mcp/

# hypothesis-testing skill: working records of one investigation, not shipped
# content - the skill itself lives in .claude/skills/ and stays tracked.
.claude/hypothesis-testing/

# pnpm is the package manager. A stray `npm install` once committed this and
# doubled every Dependabot alert.
package-lock.json

# Ruff cache, from any python tooling that runs here. Never content.
.ruff_cache/

# npx skills' own install target - third-party skill packages pulled on
# demand, never this repo's content. One got committed here once and its
# doc examples tripped a secrets scanner as real credentials.
.agents/
skills-lock.json

# `npx skills add` also drops a symlink into .claude/skills/ pointing at its
# install in .agents/, which is ignored above. Committing the link ships a
# dangling one: a fresh clone gets a skill directory resolving to nothing.
# This repo's own skills are real directories and stay tracked.
.claude/skills/autofix
.claude/skills/ci-cd-and-automation
.claude/skills/code-review
.claude/skills/open-sourcing
# Copied rather than linked by newer `skills` CLIs, but still theirs, not
# ours. Reinstall: npx skills add antfu/skills --skill nitro --skill tsdown --skill vite
.claude/skills/nitro
.claude/skills/tsdown
.claude/skills/vite

# Claude Code's per-machine settings. It rewrites this file as permissions are
# granted, so committing it would mean one person's answers becoming everyone's
# - and leaving it merely untracked meant the linter kept finding a file that
# changes under it. Ignored is the state that is true: local, and nobody's
# business but this machine's.
.claude/settings.local.json

# Editor and build state. None of it is content, and all of it lands by
# accident rather than by decision.
# TypeScript's incremental build cache. Per-machine, and it
# lands the moment anybody runs tsc with --incremental.
*.tsbuildinfo
# Coverage output. Regenerated by any run, and large.
coverage/
# Editor state. One person's window layout is nobody else's.
.vscode/
.idea/
# Anything somebody named `.local` meant to keep local.
*.local

# Reference material pasted in to be read, not written by this repo. The
# doctor's file list is `--cached --others`, deliberately: an uncommitted file
# that breaks a style rule should fail here rather than in CI after the commit.
# The cost is that anything dropped in to be looked at is held to prose rules
# it was never written under, so scratch has a name and the name is ignored.
scratch/
*.scratch.md
abc.md

# Reference material pasted in to be read, not prose this repo wrote. The
# doctor's file list is `--cached --others` on purpose: an uncommitted file that
# breaks a rule should fail here rather than in CI just after the commit. The
# cost is that anything dropped in to be looked at gets held to writing rules it
# was never written under, so scratch has a name and the name is ignored.
scratch/
*.scratch.md
